@Library('taskflow-lib@main') _
pipeline {
  agent any
  tools { nodejs 'NodeJS22' }
  options { timestamps(); skipDefaultCheckout(true); disableConcurrentBuilds() }
  environment { CI = 'true' }
  parameters {
    choice(name: 'GIT_REF', choices: ['main', 'develop', 'feature/interfaz-tareas'], description: 'Rama de la aplicación')
  }
  stages {
    stage('Checkout') {
      steps {
        script {
          if (!env.GIT_REPOSITORY_URL?.trim() || !env.GIT_CREDENTIALS_ID?.trim()) {
            error 'Configurar GIT_REPOSITORY_URL y GIT_CREDENTIALS_ID en las variables globales de Jenkins.'
          }
          git branch: params.GIT_REF, credentialsId: env.GIT_CREDENTIALS_ID, url: env.GIT_REPOSITORY_URL
        }
      }
    }
    stage('Unitarias') {
      steps { script { ciTasks.run('npm run test:unit', env.JENKINS_HOME + '\\npm-taskflow-cache') } }
      post { always { junit testResults: 'reports/vitest.xml' } }
    }
    stage('Integración') {
      when { expression { params.GIT_REF == 'develop' || params.GIT_REF == 'main' } }
      steps { script { ciTasks.run('npm run test:integration', env.JENKINS_HOME + '\\npm-taskflow-cache') } }
      post { always { junit testResults: 'reports/vitest.xml' } }
    }
    stage('E2E') {
      when { expression { params.GIT_REF == 'main' } }
      steps {
        bat 'npx playwright install chromium'
        bat 'npx playwright test'
      }
      post { always { junit testResults: 'reports/playwright.xml' } }
    }
  }
  post {
    always { script { echo 'Duración pruebas: ' + currentBuild.durationString } }
    success { echo 'Pruebas correctas' }
    failure { echo 'Pruebas fallidas' }
  }
}
